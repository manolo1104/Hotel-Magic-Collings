# ============================================================
# Variables de entorno — Magic Collinn
# Copia este archivo a .env.local para desarrollo.
# El sitio funciona sin ninguna de estas (modo WhatsApp + PGlite local);
# cada bloque "enciende" una capacidad cuando lo configuras.
# ============================================================

# ── Base de datos ──────────────────────────────────────────
# DEJAR VACÍO EN DESARROLLO → se usa PGlite local (./.pglite), sin instalar nada.
# En PRODUCCIÓN (CRÍTICA): URL de Postgres (Supabase / Neon / Railway).
# Sin esto, en Vercel las reservas NO persisten entre visitas.
DATABASE_URL=

# ── Mercado Pago (pago en línea) ───────────────────────────
# Sin MP_ACCESS_TOKEN, la reserva se hace por WhatsApp (sin cobro en línea).
# Pruebas: empieza con TEST-...   ·   Producción: empieza con APP_USR-...
MP_ACCESS_TOKEN=
# (Opcional, recomendado) Secreto para validar la firma del webhook (panel MP).
MP_WEBHOOK_SECRET=

# URL pública del sitio (Mercado Pago la usa para volver y para el webhook).
# Producción: https://www.hotelmagicollinn.com  ·  Local con pago: la URL del túnel.
NEXT_PUBLIC_BASE_URL=https://www.hotelmagicollinn.com

# ── Correos de confirmación (Resend) ───────────────────────
# Sin RESEND_API_KEY no se envían correos (el resto del flujo sigue igual).
RESEND_API_KEY=
# Remitente. Pruebas: onboarding@resend.dev  ·  Producción: dominio verificado.
RESEND_FROM=Magic Collinn <onboarding@resend.dev>
# Correo del hotel para el aviso de "nueva reserva pagada" (si no, usa el de lib/site.ts).
OWNER_EMAIL=
# Bandeja que recibe los mensajes del formulario de contacto (/api/contacto).
# Si está vacío usa OWNER_EMAIL y, en su defecto, el correo de lib/site.ts.
CONTACT_TO=

# ── Conexión con Kora (CRM) ────────────────────────────────
# Cada reserva pagada se empuja al CRM de Kora vía su endpoint público.
KORA_LEADS_URL=https://kora-hotel.com/api/leads

# ── Panel de reservas /admin ───────────────────────────────
# Contraseña para entrar al panel del hotel.
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión (cadena larga aleatoria, p. ej. 32+ chars).
ADMIN_SESSION_SECRET=

# ── Canales OTA — sincronización automática ────────────────
# El sitio corre en Railway, que NO lee vercel.json. El reloj vive dentro del
# propio servidor (lib/scheduler.ts, arrancado por instrumentation.ts) y no
# necesita ninguna variable para funcionar: en producción se prende solo.
#
# "0" apaga el reloj; "1" lo prende en desarrollo (por defecto: solo producción).
SCHEDULER_ENABLED=
# Cada cuántos minutos se sincronizan los canales (default 15, mínimo 5).
ICAL_SYNC_MINUTES=
# Segundos de espera antes de la primera corrida tras arrancar (default 30).
SCHEDULER_DELAY_SEC=
#
# Secreto para disparar la sincronización a mano desde fuera:
#   curl -H "Authorization: Bearer <CRON_SECRET>" .../api/cron/ical-sync
# Sin él ese endpoint responde 401. El reloj interno NO lo necesita.
# Requiere DATABASE_URL para que los bloqueos importados persistan.
CRON_SECRET=

# ── Beds24 — channel manager con Booking.com (2 direcciones) ─
# Sin BEDS24_REFRESH_TOKEN todo esto queda apagado y el sitio funciona igual
# que hoy (sin sincronización con Booking).
#
# CÓMO OBTENERLO (una sola vez):
#   1. Crear la cuenta en beds24.com y conectar Booking.com desde su panel.
#   2. Generar un código de invitación en
#      beds24.com/control3.php?pagetype=apiv2
#      con los permisos: bookings, inventory, properties.
#   3. Canjearlo (el código caduca en minutos y es de un solo uso):
#        npm run beds24:conectar -- <código>
#   4. Pegar aquí (y en Railway) el refreshToken que imprime.
# El token permanece válido mientras se use al menos cada 30 días; el reloj del
# sitio lo usa solo, así que no caduca estando el sitio en línea.
BEDS24_REFRESH_TOKEN=

# Secreto del webhook (invéntalo, cadena larga aleatoria). Se configura en
# Beds24 → Settings → Properties → Access → Booking webhooks, con la URL:
#   https://www.hotelmagicollinn.com/api/beds24/webhook?secret=<este valor>
# Sin él, el endpoint responde 404 y solo queda la repesca del reloj.
BEDS24_WEBHOOK_SECRET=

# Cada cuántos minutos se repescan las reservas de Booking (default 5, mínimo 5).
# Es el respaldo del webhook; bajarlo no hace falta y quema créditos de la API.
BEDS24_SYNC_MINUTES=

# (Solo para pruebas) Apunta la API a otro servidor, p. ej. uno falso local.
# BEDS24_API_URL=https://api.beds24.com/v2

# ── Google Analytics (opcional) ────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXX

# ── Google Search Console (opcional) ───────────────────────
# Código de la meta tag de verificación (solo el valor de "content").
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
