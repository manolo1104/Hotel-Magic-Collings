# ============================================================
# Variables de entorno — Magic Collinn
# Copia este archivo a .env.local para desarrollo.
# El sitio funciona sin ninguna de estas (modo WhatsApp + PGlite local);
# cada bloque "enciende" una capacidad cuando lo configuras.
# ============================================================

# ── Base de datos ──────────────────────────────────────────
# DEJAR VACÍO EN DESARROLLO → se usa PGlite local (./.pglite), sin instalar nada.
# En PRODUCCIÓN (CRÍTICA): URL de Postgres (Supabase / Neon / Railway).
# Sin esto, en Vercel las reservas NO persisten entre visitas.
DATABASE_URL=

# ── Mercado Pago (pago en línea) ───────────────────────────
# Sin MP_ACCESS_TOKEN, la reserva se hace por WhatsApp (sin cobro en línea).
# Pruebas: empieza con TEST-...   ·   Producción: empieza con APP_USR-...
MP_ACCESS_TOKEN=
# (Opcional, recomendado) Secreto para validar la firma del webhook (panel MP).
MP_WEBHOOK_SECRET=

# URL pública del sitio (Mercado Pago la usa para volver y para el webhook).
# Producción: https://magic-collinn.vercel.app  ·  Local con pago: la URL del túnel.
NEXT_PUBLIC_BASE_URL=https://magic-collinn.vercel.app

# ── Correos de confirmación (Resend) ───────────────────────
# Sin RESEND_API_KEY no se envían correos (el resto del flujo sigue igual).
RESEND_API_KEY=
# Remitente. Pruebas: onboarding@resend.dev  ·  Producción: dominio verificado.
RESEND_FROM=Magic Collinn <onboarding@resend.dev>
# Correo del hotel para el aviso de "nueva reserva pagada" (si no, usa el de lib/site.ts).
OWNER_EMAIL=

# ── Conexión con Kora (CRM) ────────────────────────────────
# Cada reserva pagada se empuja al CRM de Kora vía su endpoint público.
KORA_LEADS_URL=https://kora-hotel.com/api/leads

# ── Panel de reservas /admin ───────────────────────────────
# Contraseña para entrar al panel del hotel.
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión (cadena larga aleatoria, p. ej. 32+ chars).
ADMIN_SESSION_SECRET=

# ── Canales OTA (Booking/Expedia) — sincronización automática ─
# Secreto del cron de Vercel que sincroniza los calendarios iCal cada 6 h
# (definido en vercel.json). Vercel lo envía como "Authorization: Bearer <CRON_SECRET>".
# Requiere DATABASE_URL para que los bloqueos importados persistan.
CRON_SECRET=

# ── Google Analytics (opcional) ────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXX
