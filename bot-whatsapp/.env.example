# Puente de WhatsApp de Magic Collinn — variables (en Railway: pestaña Variables)

# El sitio donde vive el cerebro. CON www (sin www el 301 convierte POST en GET).
SITE_URL=https://www.hotelmagicollinn.com
# El mismo valor que BOT_SECRET en Vercel. Sin él el sitio rechaza todo.
BOT_SECRET=
# Contraseña de la página del QR: https://<dominio-de-railway>/?token=<esto>
QR_PAGE_TOKEN=
# WhatsApp personal de Gersay para los avisos (52 + 10 dígitos; varios con coma).
OWNER_WHATSAPP=
# Números de prueba a los que el bot contesta aunque estén en la agenda.
ALWAYS_RESPOND_NUMBERS=
# Sesión de WhatsApp en el disco persistente de Railway (volumen montado en /data).
WWEBJS_DATA_PATH=/data/wwebjs

# Opcionales (valores por omisión entre paréntesis)
# MESSAGE_DEBOUNCE_MS=15000   (espera a que el huésped deje de escribir)
# MESSAGE_MAX_WAIT_MS=60000   (tope de espera)
# HUMAN_TAKEOVER_MIN=720      (minutos que se calla si Gersay escribe a mano)
# PUPPETEER_EXECUTABLE_PATH   (en la Mac: Google Chrome; en Railway lo pone el Dockerfile)
